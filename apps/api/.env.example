APP_NAME="Digitalisasi Arsip API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# PRODUCTION: Set APP_ENV=production, APP_DEBUG=false, generate new APP_KEY
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital-archive
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: Set SESSION_DOMAIN to your actual domain (e.g., arsip.example.com)

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost,127.0.0.1,127.0.0.1:3000
# PRODUCTION: Set to your frontend domain (e.g., arsip.example.com)

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PRODUCTION: Set to your frontend URL (e.g., https://arsip.example.com)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# File Security Options
ENCRYPT_DOCUMENTS=false  # Set to true to encrypt uploaded documents at rest
SCAN_PDFS=false          # Set to true to enable PDF malware scanning (requires Ghostscript)

QUEUE_CONNECTION=database


CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fakultas_teknik.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
